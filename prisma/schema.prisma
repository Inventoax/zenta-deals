// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  USER
  AGENT
  ADMIN
}

// --- MODELS ---

model User {
  id        String      @id @default(cuid())
  name      String?
  email     String      @unique
  phone     String?
  password  String?
  role      Role        @default(USER)
  balance   Float       @default(0.0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  // Relations
  orders       Order[]
  transactions Transaction[]
}

model AfaRequest {
  id          String   @id @default(cuid())
  fullName    String
  email       String?  
  phone       String?  
  ghanaCardId String   // Removed @unique here
  region      String
  status      String   @default("PENDING") 
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  type        String   // e.g., "DATA", "VOUCHER"
  network     String?  // e.g., "MTN", "VODAFONE"
  phone       String?  // Recipient phone number
  amount      Float
  planId      String?  // Optional, if it's a data plan purchase
  description String?
  status      String   @default("PENDING") // e.g., "PENDING", "SUCCESS", "FAILED"
  createdAt   DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  plan        DataPlan? @relation(fields: [planId], references: [id])
}

model DataPlan {
  id            String   @id @default(cuid())
  network       String   // e.g., "MTN"
  name          String   // e.g., "MTN 5GB Flash"
  size          String   // e.g., "5GB"
  validity      String   @default("30 Days")
  description   String?
  customerPrice Float
  agentPrice    Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Relations
  orders        Order[]
}

model VoucherProduct {
  id        String   @id @default(uuid())
  name      String   @unique // e.g., "MTN GH₵ 10"
  type      String   // e.g., "MTN E-PIN"
  cost      Float    @default(0.0) // What you pay for it
  price     Float    @default(0.0) // What you sell it for
  status    String   @default("Active") // "Active", "Inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id              String  @id @default(cuid())
  siteName        String  @default("Zenta Deals")
  supportPhone    String  @default("233556631260")
  maintenanceMode Boolean @default(false)
  allowSignups    Boolean @default(true)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // e.g., "TOPUP", "PURCHASE", "REFUND"
  status      String   // e.g., "SUCCESS", "FAILED"
  reference   String   @unique // Unique payment gateway reference
  description String?
  createdAt   DateTime @default(now())

  // Relation back to User
  user        User     @relation(fields: [userId], references: [id])
}